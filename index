// ---------------- live feeds (realtime, in-browser) ----------------
const LIVE_SOURCES = [
  { name: "EURAXESS", kw: "sociology", url: "https://r.jina.ai/https://euraxess.ec.europa.eu/jobs/search?keywords=sociology", re: /\[([^\]]{10,200})\]\((https:\/\/euraxess\.ec\.europa\.eu\/jobs\/\d+[^)\s]*)\)/g },
  { name: "EURAXESS", kw: "social work", url: "https://r.jina.ai/https://euraxess.ec.europa.eu/jobs/search?keywords=social%20work", re: /\[([^\]]{10,200})\]\((https:\/\/euraxess\.ec\.europa\.eu\/jobs\/\d+[^)\s]*)\)/g },
  { name: "EURAXESS", kw: "buddhism", url: "https://r.jina.ai/https://euraxess.ec.europa.eu/jobs/search?keywords=buddhism", re: /\[([^\]]{10,200})\]\((https:\/\/euraxess\.ec\.europa\.eu\/jobs\/\d+[^)\s]*)\)/g },
  { name: "jobs.ac.uk", kw: "sociology", url: "https://r.jina.ai/https://www.jobs.ac.uk/search/?keywords=sociology", re: /\[([^\]]{10,200})\]\((https:\/\/www\.jobs\.ac\.uk\/job\/[A-Z0-9]+\/[^)\s]+)\)/g },
  { name: "jobs.ac.uk", kw: "social work", url: "https://r.jina.ai/https://www.jobs.ac.uk/search/?keywords=social%20work", re: /\[([^\]]{10,200})\]\((https:\/\/www\.jobs\.ac\.uk\/job\/[A-Z0-9]+\/[^)\s]+)\)/g },
  { name: "jobs.ac.uk", kw: "buddhism", url: "https://r.jina.ai/https://www.jobs.ac.uk/search/?keywords=buddhism", re: /\[([^\]]{10,200})\]\((https:\/\/www\.jobs\.ac\.uk\/job\/[A-Z0-9]+\/[^)\s]+)\)/g },
];
let ALL_JOBS = [], feedFilter = "all";

function cleanJob(s = "") { return s.replace(/&amp;/g, "&").replace(/\s+/g, " ").trim(); }

function renderFeed() {
  const box = document.getElementById("feedResults");
  box.innerHTML = "";
  const shown = ALL_JOBS.filter(j => feedFilter === "all" || j.kw === feedFilter || (feedFilter === "buddhist" && j.kw === "buddhism"));
  shown.forEach(j => {
    const div = document.createElement("div");
    div.className = "job";
    div.innerHTML = `<a href="${j.link}" target="_blank" rel="noopener">${j.title}</a><div class="meta">${j.source} Â· ${j.kw}</div>`;
    box.appendChild(div);
  });
  if (!shown.length) box.innerHTML = `<p class="feeds">No postings${feedFilter !== "all" ? " for â€œ" + feedFilter + "â€" : ""} right now â€” try Refresh.</p>`;
}

function setFeedStatus(txt) { document.getElementById("feedStatus").textContent = txt; }

async function loadSnapshot() {
  try {
    let data = window.FEEDS_DATA; // inlined in share.html
    if (!data) {
      const res = await fetch("./feeds.json");
      if (!res.ok) throw new Error();
      data = await res.json();
    }
    if (ALL_JOBS.length) return false; // live data already present â€” keep it
    ALL_JOBS = data.jobs || [];
    setFeedStatus(`${ALL_JOBS.length} results Â· snapshot ${new Date(data.fetched).toLocaleString()} (offline mode)`);
    renderFeed();
    return true;
  } catch { return false; }
}

async function fetchLive() {
  setFeedStatus("fetching liveâ€¦");
  const settled = await Promise.allSettled(LIVE_SOURCES.map(async s => {
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 30000);
    try {
      const r = await fetch(s.url, { signal: ctrl.signal });
      if (!r.ok) throw new Error("HTTP " + r.status);
      const text = await r.text();
      if (/Just a moment/i.test(text.slice(0, 500))) throw new Error("blocked");
      const jobs = []; let m;
      s.re.lastIndex = 0;
      while ((m = s.re.exec(text)) !== null) jobs.push({ title: cleanJob(m[1]), link: m[2], source: s.name, kw: s.kw });
      return jobs;
    } finally { clearTimeout(timer); }
  }));
  const merged = [];
  const seen = new Set();
  let okCount = 0;
  settled.forEach(r => { if (r.status === "fulfilled") { okCount++; merged.push(...r.value); } });
  const jobs = merged.filter(j => (seen.has(j.link) ? false : (seen.add(j.link), true)));
  if (!jobs.length) {
    const hadSnapshot = await loadSnapshot();
    if (!hadSnapshot) setFeedStatus("live fetch failed â€” no snapshot available");
    return;
  }
  ALL_JOBS = jobs;
  setFeedStatus(`${jobs.length} live results Â· ${okCount}/${LIVE_SOURCES.length} sources Â· ${new Date().toLocaleTimeString()}`);
  renderFeed();
}

document.getElementById("refreshBtn").onclick = fetchLive;
